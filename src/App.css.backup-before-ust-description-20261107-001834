
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #101722;
  --sidebar: #141f2d;
  --surface: #1b2939;
  --surface-2: #223448;
  --surface-3: #2b4056;
  --border: #3b5065;
  --border-bright: #536d84;
  --text: #f3f6fa;
  --muted: #c0ccda;
  --subtle: #a3b3c4;
  --cyan: #65d5f2;
  --cyan-soft: rgba(101, 213, 242, 0.12);
  --green: #73e0ad;
  --amber: #ffd08a;
  --red: #ff9299;
  --mono: 'DM Mono', Consolas, monospace;
  --sans: Inter, 'Segoe UI', Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.7;
  text-align: left;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  opacity: 0.55;
  cursor: wait;
}

a {
  color: var(--cyan);
  text-decoration: none;
}

a:hover {
  color: #a4ebff;
  text-decoration: underline;
}

:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 3px;
}

/* APPLICATION */

.mission-app {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 75% 0%, rgba(49, 103, 143, 0.13), transparent 40%),
    var(--bg);
}

/* SIDEBAR */

.sidebar {
  position: fixed;
  z-index: 20;
  inset: 0 auto 0 0;
  width: 246px;
  display: flex;
  flex-direction: column;
  padding: 26px 18px 20px;
  background: var(--sidebar);
  border-right: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 54px;
  padding: 0 8px;
  margin-bottom: 48px;
}

.brand-symbol {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid var(--cyan);
  border-radius: 10px;
  color: var(--cyan);
  font-size: 25px;
}

.brand strong,
.brand small,
.sidebar-bottom strong,
.sidebar-bottom small {
  display: block;
}

.brand strong {
  font-size: 14px;
  letter-spacing: 1px;
}

.brand small {
  color: var(--muted);
  font: 10px var(--mono);
  margin-top: 4px;
}

.sidebar-section-label,
.module-code,
.header-kicker,
.config-field label,
.coordinate-readout span,
.engine-readout span,
.telemetry-label,
.mission-status-strip span,
.map-overlay span {
  color: var(--subtle);
  font: 11px var(--mono);
  letter-spacing: 0.8px;
}

.sidebar-section-label {
  padding: 0 10px;
  margin-bottom: 13px;
}

.side-navigation {
  display: grid;
  gap: 6px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 45px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 6px;
  color: var(--muted);
  font-size: 13px;
  transition: 0.2s ease;
}

.nav-item span {
  width: 20px;
  color: var(--subtle);
  font-size: 18px;
  text-align: center;
}

.nav-item:hover,
.nav-item.active {
  color: var(--text);
  background: var(--cyan-soft);
  border-color: rgba(101, 213, 242, 0.3);
}

.nav-item.active span {
  color: var(--cyan);
}

.sidebar-bottom {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: auto;
  padding: 16px 9px 5px;
  border-top: 1px solid var(--border);
}

.sidebar-bottom strong {
  font: 11px var(--mono);
}

.sidebar-bottom small {
  color: var(--muted);
  font: 10px var(--mono);
  margin-top: 4px;
}

.system-dot {
  width: 9px;
  height: 9px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px rgba(115, 224, 173, 0.35);
}

/* MAIN WORKSPACE */

.workspace {
  min-height: 100vh;
  margin-left: 246px;
}

.system-header {
  height: 70px;
  position: sticky;
  top: 0;
  z-index: 15;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 0 38px;
  background: rgba(20, 31, 45, 0.96);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(16px);
}

.system-header > div:first-child {
  display: grid;
  gap: 3px;
}

.system-header > div:first-child strong {
  font-size: 13px;
  font-weight: 600;
}

.header-status {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font: 10px var(--mono);
}

.header-status .system-dot {
  width: 8px;
  height: 8px;
}

.header-divider {
  width: 1px;
  height: 16px;
  background: var(--border-bright);
}

.dashboard-content {
  width: 100%;
  max-width: 1720px;
  padding: 34px 38px 28px;
  margin: 0 auto;
}

/* PAGE INTRODUCTION */

.page-intro {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 24px;
  margin-bottom: 25px;
}

.page-intro h1 {
  margin: 9px 0 10px;
  color: #ffffff;
  font-size: clamp(28px, 3vw, 38px);
  font-weight: 700;
  letter-spacing: -1px;
  line-height: 1.2;
}

.page-intro p {
  max-width: 720px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}

.external-link {
  flex: 0 0 auto;
  padding: 11px 14px;
  border: 1px solid var(--border-bright);
  border-radius: 5px;
  color: var(--cyan);
  font: 11px var(--mono);
}

.external-link:hover {
  background: var(--cyan-soft);
}

/* MISSION STATUS */

.mission-status-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-bottom: 22px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
}

.mission-status-strip > div {
  min-width: 0;
  display: grid;
  gap: 8px;
  padding: 16px 18px;
  border-right: 1px solid var(--border);
}

.mission-status-strip > div:last-child {
  border-right: 0;
}

.mission-status-strip strong {
  overflow-wrap: anywhere;
  color: var(--text);
  font-size: 14px;
  font-weight: 600;
}

/* DASHBOARD GRID */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(290px, 0.8fr);
  align-items: start;
  gap: 20px;
}

.dashboard-main-column,
.dashboard-side-column {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 20px;
}

/* GENERAL PANELS */

.panel {
  min-width: 0;
  padding: 22px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 9px;
}

.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
  margin-bottom: 20px;
}

.panel-heading h2 {
  margin: 7px 0 6px;
  color: var(--text);
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.3px;
}

.panel-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.live-indicator,
.engine-indicator {
  flex: 0 0 auto;
  padding: 6px 9px;
  border: 1px solid rgba(101, 213, 242, 0.35);
  border-radius: 4px;
  color: var(--cyan);
  background: var(--cyan-soft);
  font: 10px var(--mono);
}

/* LUNAR MAP */

.map-panel {
  padding: 20px;
}

.map-frame {
  position: relative;
  width: 100%;
  height: clamp(330px, 40vw, 520px);
  overflow: hidden;
  background: #111d2a;
  border: 1px solid var(--border-bright);
  border-radius: 6px;
}

.lunar-map {
  width: 100%;
  height: 100%;
  background: #1a2938;
}

.map-overlay {
  position: absolute;
  z-index: 5;
  display: grid;
  gap: 4px;
  max-width: calc(100% - 24px);
  padding: 10px 13px;
  background: rgba(13, 24, 37, 0.94);
  border: 1px solid var(--border-bright);
  border-radius: 5px;
  pointer-events: none;
}

.map-overlay strong {
  overflow-wrap: anywhere;
  color: var(--text);
  font-size: 12px;
}

/* REFERENCE REGION MOVED TO UPPER RIGHT */

.map-overlay-top {
  top: 12px;
  right: 12px;
  left: auto;
}

.map-overlay-bottom {
  right: 12px;
  bottom: 12px;
}

.map-overlay-bottom strong {
  color: var(--cyan);
}

.technical-note {
  margin: 13px 0 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.75;
}

/* REFERENCE LOCATIONS */

.location-list {
  display: grid;
  gap: 9px;
}

.location-option {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px;
  text-align: left;
  color: var(--text);
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
  cursor: pointer;
  transition: 0.2s ease;
}

.location-option:hover,
.location-option.selected {
  border-color: var(--cyan);
  background: var(--cyan-soft);
}

.location-index {
  color: var(--cyan);
  font: 12px var(--mono);
}

.location-option-copy {
  flex: 1;
  min-width: 0;
  display: grid;
  gap: 4px;
}

.location-option-copy strong {
  font-size: 14px;
  font-weight: 600;
}

.location-option-copy small {
  color: var(--muted);
  font-size: 12px;
}

.location-select-mark {
  flex: 0 0 auto;
  color: var(--subtle);
  font: 10px var(--mono);
}

.location-option.selected .location-select-mark {
  color: var(--cyan);
}

/* TELEMETRY */

.telemetry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  align-items: stretch;
}

.telemetry-card {
  min-width: 0;
  min-height: 245px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 15px;
  padding: 23px;
  background: linear-gradient(145deg, #2a4158, #1b2b3d);
  border: 1px solid #58728b;
  border-top: 4px solid #65d5f2;
  border-radius: 8px;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.15);
}

.telemetry-label {
  display: block;
  width: 100%;
  padding-bottom: 12px;
  color: #a4ebff !important;
  border-bottom: 1px solid #536d84;
  font-family: var(--mono);
  font-size: 14px !important;
  font-weight: 700 !important;
  letter-spacing: 1.5px;
  line-height: 1.5;
}

.telemetry-value {
  display: block;
  min-height: 45px;
  margin: 3px 0 0;
  color: #ffffff !important;
  font-size: clamp(30px, 3vw, 40px) !important;
  font-weight: 800 !important;
  letter-spacing: -0.8px;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.telemetry-text-value {
  font-size: clamp(23px, 2.4vw, 32px) !important;
  letter-spacing: 0;
}

.telemetry-foot {
  display: block;
  min-height: 42px;
  padding-top: 9px;
  color: #d4e0eb !important;
  border-top: 1px solid rgba(83, 109, 132, 0.5);
  font-size: 13px;
  line-height: 1.65;
}

.telemetry-action-button {
  width: 100%;
  min-height: 47px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
  padding: 12px;
  color: #a4ebff !important;
  background: rgba(101, 213, 242, 0.14);
  border: 1px solid #65d5f2;
  border-radius: 5px;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.8px;
  text-align: center;
  white-space: normal;
}

.telemetry-action-button:hover:not(:disabled) {
  color: #ffffff !important;
  background: rgba(101, 213, 242, 0.27);
  border-color: #a4ebff;
}

/* BUTTONS */

.action-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: 43px;
  padding: 10px 13px;
  color: var(--cyan);
  background: var(--cyan-soft);
  border: 1px solid rgba(101, 213, 242, 0.4);
  border-radius: 5px;
  font: 11px var(--mono);
  cursor: pointer;
  transition: 0.2s ease;
}

.action-button:hover:not(:disabled) {
  background: rgba(101, 213, 242, 0.22);
  border-color: var(--cyan);
}

.primary-action {
  max-width: 260px;
}

/* CALCULATION RESULTS */

.detail-readout {
  display: grid;
  gap: 9px;
  margin-top: 15px;
  padding: 16px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.detail-readout > strong {
  margin-bottom: 3px;
  color: var(--cyan);
  font-size: 13px;
}

.detail-readout p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.detail-readout h3 {
  margin: 9px 0 3px;
  font-size: 15px;
}

.window-row {
  display: grid;
  grid-template-columns: auto 1fr 1fr;
  gap: 12px;
  padding: 11px 0;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font: 12px var(--mono);
}

.window-row strong {
  color: var(--cyan);
}

/* CONFIGURATION */

.config-panel .panel-heading {
  margin-bottom: 23px;
}

.config-field {
  display: grid;
  gap: 9px;
  margin-bottom: 19px;
}

.config-field label {
  color: var(--muted);
  font-size: 12px;
}

.config-field input,
.config-field select {
  width: 100%;
  min-width: 0;
  min-height: 45px;
  padding: 10px 12px;
  color: var(--text);
  background: #152436;
  border: 1px solid var(--border-bright);
  border-radius: 5px;
  outline: none;
  color-scheme: dark;
  font-size: 14px;
}

.config-field input:focus,
.config-field select:focus {
  border-color: var(--cyan);
}

.coordinate-readout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 11px;
  margin-top: 23px;
  padding: 15px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.coordinate-readout strong {
  color: var(--text);
  font: 14px var(--mono);
}

/* SPICE ENGINE */

.engine-panel {
  padding: 20px;
}

.engine-readout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 7px;
}

.engine-readout strong {
  margin-bottom: 10px;
  color: var(--text);
  font: 13px var(--mono);
  overflow-wrap: anywhere;
}

.engine-readout span {
  font-size: 11px;
}

.engine-indicator {
  color: var(--amber);
  border-color: rgba(255, 208, 138, 0.4);
  background: rgba(255, 208, 138, 0.1);
}

/* ERRORS */

.error-panel {
  border-color: rgba(255, 146, 153, 0.6);
}

.error-panel strong {
  color: var(--red);
  font: 12px var(--mono);
}

.error-panel p {
  margin: 9px 0 0;
  color: #ffd0d3;
  font-size: 14px;
  overflow-wrap: anywhere;
}

/* CLPS HOST AND REGISTRY */

.clps-host-panel {
  margin-top: 24px;
}

.clps-host-panel > .clps-section {
  margin: 0;
}

.clps-section {
  min-width: 0;
  color: var(--text);
}

.clps-section .section-heading {
  margin-bottom: 21px;
}

.clps-section .section-heading h2 {
  margin: 7px 0;
  color: var(--text);
  font-size: 23px;
  font-weight: 700;
}

.clps-section .section-description {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.clps-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210px;
  gap: 12px;
  margin: 20px 0;
}

.clps-controls input,
.clps-controls select {
  min-width: 0;
  min-height: 45px;
  padding: 10px 13px;
  color: var(--text);
  background: #152436;
  border: 1px solid var(--border-bright);
  border-radius: 5px;
  outline: none;
  color-scheme: dark;
  font-size: 14px;
}

.clps-controls input:focus,
.clps-controls select:focus {
  border-color: var(--cyan);
}

.clps-table-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin: 22px 0 12px;
}

.clps-count {
  color: var(--muted);
  font: 12px var(--mono);
}

.clps-table-wrap {
  width: 100%;
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface-2);
}

.clps-table {
  width: 100%;
  min-width: 1050px;
  border-collapse: collapse;
  text-align: left;
}

.clps-table th {
  padding: 15px 14px;
  color: var(--muted);
  background: #24364a;
  border-bottom: 1px solid var(--border-bright);
  font: 11px var(--mono);
  letter-spacing: 0.5px;
  text-transform: uppercase;
  white-space: nowrap;
}

.clps-table td {
  padding: 16px 14px;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  line-height: 1.6;
  vertical-align: top;
}

.clps-table tbody tr:last-child td {
  border-bottom: 0;
}

.clps-table tbody tr:hover {
  background: rgba(101, 213, 242, 0.06);
}

.clps-table td strong {
  display: block;
  margin-bottom: 5px;
  color: var(--text);
  font-size: 14px;
  font-weight: 700;
}

.clps-payload {
  display: block;
  max-width: 240px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
  white-space: normal;
}

.clps-table td a {
  color: var(--cyan);
  font: 12px var(--mono);
}

.clps-table td a:hover {
  text-decoration: underline;
}

/* MISSION STATUS LABELS */

.clps-status {
  display: inline-block;
  padding: 5px 9px;
  border: 1px solid var(--border-bright);
  border-radius: 4px;
  color: var(--muted);
  font: 11px var(--mono);
  white-space: nowrap;
}

.status-completed {
  color: var(--green);
  border-color: rgba(115, 224, 173, 0.4);
  background: rgba(115, 224, 173, 0.09);
}

.status-failed {
  color: var(--red);
  border-color: rgba(255, 146, 153, 0.4);
  background: rgba(255, 146, 153, 0.09);
}

.status-planned,
.status-in-development {
  color: var(--amber);
  border-color: rgba(255, 208, 138, 0.4);
  background: rgba(255, 208, 138, 0.09);
}

.status-launched,
.status-landed {
  color: var(--cyan);
  border-color: rgba(101, 213, 242, 0.4);
  background: var(--cyan-soft);
}

/* REGISTRY NOTICES */

.clps-data-notice {
  margin-top: 18px;
  padding: 17px 19px;
  background: rgba(255, 208, 138, 0.08);
  border: 1px solid rgba(255, 208, 138, 0.35);
  border-radius: 6px;
  color: var(--text);
  font-size: 14px;
  line-height: 1.8;
}

.clps-data-notice strong {
  color: var(--amber);
  font: 12px var(--mono);
  letter-spacing: 0.5px;
}

.clps-data-notice p,
.clps-empty {
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

/* EXPANDABLE MISSION DETAILS */

.clps-details-button {
  padding: 8px 11px;
  color: var(--cyan);
  background: var(--cyan-soft);
  border: 1px solid rgba(101, 213, 242, 0.4);
  border-radius: 4px;
  font: 12px var(--mono);
  cursor: pointer;
  white-space: nowrap;
}

.clps-details-button:hover {
  background: rgba(101, 213, 242, 0.22);
  border-color: var(--cyan);
}

.clps-expanded-row td {
  padding: 0 !important;
  background: #152334;
}

.clps-expanded-content {
  display: flex;
  flex-direction: column;
  gap: 22px;
  padding: 24px;
}

.clps-expanded-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

.clps-expanded-heading h3 {
  margin: 7px 0 0;
  color: var(--text);
  font-size: 23px;
  line-height: 1.3;
  font-weight: 700;
}

/* NUMBERED SECTION HEADINGS */

.clps-numbered-heading {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  margin: 12px 0 0;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
  color: var(--text);
  font-size: 16px;
  line-height: 1.4;
  font-weight: 700;
}

.clps-heading-number {
  display: inline-flex;
  flex: 0 0 36px;
  width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--cyan);
  border-radius: 8px;
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 700;
}

.clps-heading-title {
  display: block;
  min-width: 0;
}

/* MISSION IDENTIFICATION AND CHRONOLOGY */

.clps-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  width: 100%;
}

.clps-detail-grid > div {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 9px;
  min-width: 0;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--surface-2);
}

.clps-detail-grid > div > span {
  display: block;
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: 0.09em;
  font-weight: 700;
}

.clps-detail-grid > div > strong {
  display: block;
  width: 100%;
  color: var(--text);
  font-size: 14px;
  line-height: 1.65;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.clps-detail-grid .clps-payload-detail {
  grid-column: 1 / -1;
}

.clps-chronology {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0;
  padding: 4px 0 4px 25px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.clps-chronology li {
  padding-left: 5px;
}

/* PAYLOAD REGISTER */

.clps-payload-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 10px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--surface);
}

.clps-payload-heading h4 {
  margin: 6px 0 0;
  color: var(--text);
  font-size: 17px;
  line-height: 1.4;
}

.clps-payload-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  width: 100%;
  margin-top: 18px;
}

.clps-payload-card {
  display: flex;
  flex-direction: column;
  gap: 17px;
  min-width: 0;
  padding: 19px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-2);
}

.clps-payload-card-heading {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--border);
}

.clps-payload-number {
  display: flex;
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: rgba(101, 213, 242, 0.12);
  border: 1px solid var(--cyan);
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 700;
}

.clps-payload-title {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.clps-payload-title > strong {
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 13px;
  letter-spacing: 0.06em;
}

.clps-payload-title h5 {
  margin: 0;
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
}

.clps-payload-fields {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.clps-payload-fields > div {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
  padding: 14px;
  background: rgba(12, 23, 36, 0.65);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.clps-payload-fields > div:first-child {
  grid-column: 1 / -1;
}

.clps-payload-fields > div > span {
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: 0.08em;
  font-weight: 700;
}

.clps-payload-fields strong {
  display: block;
  margin-bottom: 8px;
  color: var(--cyan);
  font: 11px var(--mono);
  letter-spacing: 0.5px;
}

.clps-payload-fields p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

/* VERIFICATION AND SOURCE SECTIONS */

.clps-verification-note {
  padding: 18px;
  border-left: 3px solid var(--amber);
  border-radius: 5px;
  background: var(--surface);
}

.clps-verification-note > strong {
  color: var(--amber);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
}

.clps-verification-note p {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.clps-source-list,
.clps-payload-sources {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
}

.clps-source-list a,
.clps-payload-sources a {
  color: var(--cyan);
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
  text-decoration: none;
}

.clps-source-list a:hover,
.clps-payload-sources a:hover {
  text-decoration: underline;
}

.clps-payload-sources {
  margin-top: 17px;
  padding-top: 15px;
  border-top: 1px solid var(--border);
}

.clps-payload-sources a,
.clps-source-link {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  max-width: 100%;
  color: var(--cyan) !important;
  font-size: 13px !important;
  font-weight: 600;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.clps-payload-sources a:hover,
.clps-source-link:hover {
  color: #b3efff !important;
  text-decoration: underline;
}

.clps-source-link {
  margin-top: 15px;
}

/* DASHBOARD NUMBERING */

.numbered-module-code {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  min-height: 20px;
  color: #8fe4fa !important;
  font-weight: 500;
  line-height: 1.4;
}

.module-number {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  flex: 0 0 30px;
  width: 30px;
  min-width: 30px;
  color: #a4ebff !important;
  font-variant-numeric: tabular-nums;
  font-weight: 500;
  letter-spacing: 0.04em;
}

/* GENERAL FOOTER */

.app-footer {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 30px;
  padding: 18px 0 5px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font: 11px var(--mono);
}

/* MAP CONTROLS */

.ol-control {
  z-index: 10 !important;
  background: rgba(16, 23, 34, 0.95) !important;
  border: 1px solid var(--border-bright) !important;
  border-radius: 5px !important;
}

.ol-zoom {
  top: 12px !important;
  left: 12px !important;
  right: auto !important;
}

.ol-control button {
  display: block !important;
  width: 2em;
  height: 2em;
  margin: 2px !important;
  color: var(--text) !important;
  background: #223448 !important;
  border: 1px solid var(--border-bright) !important;
  border-radius: 3px !important;
  font-size: 1.25em !important;
  font-weight: 700 !important;
  cursor: pointer !important;
}

.ol-control button:hover {
  color: #ffffff !important;
  background: #36536d !important;
}

/* SOLAR AND EARTH TELEMETRY */

.data-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: stretch;
  gap: 16px;
}

.data-card {
  min-width: 0;
  min-height: 230px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 13px;
  padding: 22px;
  background: linear-gradient(145deg, #263d53, #1b2b3d);
  border: 1px solid #58728b;
  border-top: 3px solid var(--cyan);
  border-radius: 7px;
}

.data-card .eyebrow {
  display: block;
  margin: 0;
  color: #8fe4fa !important;
  font-family: var(--mono);
  font-size: 12px !important;
  font-weight: 500;
  letter-spacing: 1.3px;
  line-height: 1.5;
}

.data-card h3 {
  margin: 0;
  color: #ffffff !important;
  font-size: 19px !important;
  font-weight: 700;
  line-height: 1.4;
}

.data-value {
  display: block;
  min-height: 42px;
  margin: 5px 0;
  color: #ffffff !important;
  font-size: clamp(25px, 2.5vw, 34px) !important;
  font-weight: 800;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.data-card p {
  color: #cbd8e5;
  font-size: 13px;
  line-height: 1.7;
}

.calculate-button {
  width: 100%;
  min-height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
  padding: 11px 14px;
  color: #a4ebff !important;
  background: rgba(101, 213, 242, 0.13);
  border: 1px solid rgba(101, 213, 242, 0.65);
  border-radius: 5px;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-align: center;
  white-space: normal;
}

.calculate-button:hover:not(:disabled) {
  color: #ffffff !important;
  background: rgba(101, 213, 242, 0.25);
  border-color: #a4ebff;
}

/* COSMIC CALENDAR — UST */

.ust-panel {
  margin-bottom: 20px;
}

.ust-version {
  display: inline-block;
  padding: 7px 10px;
  border: 1px solid var(--border-bright);
  border-radius: 4px;
  color: var(--cyan);
  font: 11px var(--mono);
  white-space: nowrap;
}

.ust-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 13px;
}

.ust-metric {
  min-width: 0;
  padding: 17px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.ust-metric strong {
  display: block;
  margin-top: 8px;
  color: var(--text);
  font: 26px var(--mono);
  overflow-wrap: anywhere;
}

.ust-metric strong small {
  color: var(--muted);
  font-size: 14px;
}

.ust-progress-track {
  height: 10px;
  margin: 18px 0;
  background: var(--surface-3);
  border-radius: 20px;
  overflow: hidden;
}

.ust-progress-fill {
  height: 100%;
  background: var(--cyan);
  transition: width 0.25s ease;
}

.ust-details {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.ust-details > div {
  min-width: 0;
  padding: 12px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.ust-details span {
  display: block;
  color: var(--subtle);
  font: 10px var(--mono);
  letter-spacing: 0.7px;
}

.ust-details strong {
  display: block;
  margin-top: 5px;
  color: var(--text);
  font-size: 13px;
  overflow-wrap: anywhere;
}

.ust-caveat {
  margin: 16px 0 0;
  padding: 12px 14px;
  border-left: 3px solid var(--amber);
  background: rgba(255, 208, 138, 0.07);
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.ust-error {
  color: var(--red);
}

/* RESPONSIVE LAYOUT */

/* LARGE SCREENS */

@media (min-width: 1700px) {
  .dashboard-grid {
    grid-template-columns: minmax(0, 1.85fr) minmax(310px, 0.75fr);
  }
}

/* TABLET */

@media (max-width: 1100px) {
  .dashboard-content {
    padding: 26px 22px;
  }

  .system-header {
    padding: 0 22px;
  }

  .dashboard-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .dashboard-side-column {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }
}

/* MOBILE */

@media (max-width: 700px) {
  .sidebar {
    position: sticky;
    inset: 0 0 auto;
    width: 100%;
    height: auto;
    padding: 10px 14px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    min-height: 42px;
    margin: 0;
  }

  .brand-symbol {
    width: 32px;
    height: 32px;
    font-size: 21px;
  }

  .side-navigation {
    display: flex;
    gap: 5px;
    overflow-x: auto;
    padding: 9px 0 2px;
  }

  .sidebar-section-label,
  .sidebar-bottom {
    display: none;
  }

  .nav-item {
    flex: 0 0 auto;
    min-height: 36px;
    padding: 0 9px;
    font-size: 11px;
  }

  .nav-item span {
    font-size: 14px;
  }

  .workspace {
    margin-left: 0;
  }

  .system-header {
    position: static;
    height: auto;
    min-height: 54px;
    padding: 10px 15px;
  }

  .header-status {
    font-size: 9px;
    gap: 6px;
  }

  .dashboard-content {
    padding: 22px 14px;
  }

  .page-intro {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .page-intro h1 {
    font-size: 28px;
  }

  .mission-status-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .mission-status-strip > div:nth-child(2) {
    border-right: 0;
  }

  .mission-status-strip > div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }

  .panel {
    padding: 16px;
  }

  .map-frame {
    height: 340px;
  }

  .dashboard-side-column {
    grid-template-columns: 1fr;
  }

  .telemetry-grid,
  .data-grid {
    grid-template-columns: 1fr;
  }

  .telemetry-card {
    min-height: 225px;
  }

  .window-row {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .app-footer {
    flex-direction: column;
  }

  .clps-controls {
    grid-template-columns: 1fr;
  }

  .clps-table-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .clps-expanded-content {
    padding: 15px;
    gap: 17px;
  }

  .clps-detail-grid,
  .clps-payload-list {
    grid-template-columns: minmax(0, 1fr);
  }

  .clps-detail-grid .clps-payload-detail {
    grid-column: auto;
  }

  .clps-numbered-heading {
    font-size: 15px;
  }

  .clps-expanded-heading h3 {
    font-size: 19px;
  }

  .clps-payload-card {
    padding: 16px;
  }

  .clps-payload-fields {
    grid-template-columns: 1fr;
  }

  .clps-payload-fields > div:first-child {
    grid-column: auto;
  }

  .clps-payload-sources {
    display: grid;
    gap: 11px;
  }

  .ust-metrics,
  .ust-details {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 380px) {
  .header-status {
    display: none;
  }

  .location-select-mark {
    font-size: 9px;
  }

  .mission-status-strip strong {
    font-size: 12px;
  }

  .clps-expanded-heading {
    align-items: flex-start;
    flex-direction: column;
  }
}
