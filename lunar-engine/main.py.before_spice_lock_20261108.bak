from datetime import datetime, timezone
from pathlib import Path
import math

import spiceypy as spice
from fastapi import FastAPI, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware

from ust_calendar import calculate_ust


BASE_DIR = Path(__file__).resolve().parent
KERNEL_DIR = BASE_DIR / "kernels"

KERNELS = [
    "naif0012.tls",
    "pck00011.tpc",
    "moon_de440_250416.tf",
    "moon_pa_de440_200625.bpc",
    "de440.bsp",
]

MOON_RADIUS_KM = 1737.4
EARTH_RADIUS_KM = 6378.1366
MOON_FRAME = "MOON_ME_DE440_ME421"

app = FastAPI(
    title="Lunar Chronos API",
    description="Scientific calculation backend for Lunar Chronos",
    version="0.4.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:5174",
        "http://127.0.0.1:5174",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

kernels_loaded = False
kernel_error = None


@app.on_event("startup")
def load_spice_kernels():
    global kernels_loaded, kernel_error

    try:
        spice.kclear()

        for filename in KERNELS:
            kernel_path = KERNEL_DIR / filename

            if not kernel_path.is_file():
                raise FileNotFoundError(
                    f"Missing SPICE kernel: {kernel_path}"
                )

            spice.furnsh(str(kernel_path))

        if spice.namfrm(MOON_FRAME) == 0:
            raise RuntimeError(
                f"SPICE frame unavailable: {MOON_FRAME}"
            )

        kernels_loaded = True
        kernel_error = None

    except Exception as exc:
        kernels_loaded = False
        kernel_error = str(exc)


def get_observation(latitude, longitude, date_time):
    try:
        observation_time = datetime.fromisoformat(date_time)

        if observation_time.tzinfo is None:
            observation_time = observation_time.replace(
                tzinfo=timezone.utc
            )

        utc_text = observation_time.astimezone(
            timezone.utc
        ).strftime("%Y-%m-%dT%H:%M:%S")

        et = spice.utc2et(utc_text)

        lat_rad = math.radians(latitude)
        lon_rad = math.radians(longitude)

        point = [
            MOON_RADIUS_KM * math.cos(lat_rad) * math.cos(lon_rad),
            MOON_RADIUS_KM * math.cos(lat_rad) * math.sin(lon_rad),
            MOON_RADIUS_KM * math.sin(lat_rad),
        ]

        normal_unit = spice.vhat(point)

        return utc_text, et, point, normal_unit

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=f"Invalid date_time: {str(exc)}",
        )


@app.get("/")
def home():
    return {
        "project": "Lunar Chronos",
        "status": "Backend running",
        "scientific_engine": (
            "SPICE ready" if kernels_loaded else "Not available"
        ),
    }


@app.get("/health")
def health():
    return {
        "status": "healthy" if kernels_loaded else "degraded",
        "spiceypy_available": True,
        "kernels_loaded": kernels_loaded,
        "calculations_enabled": kernels_loaded,
        "kernel_error": kernel_error,
    }


@app.get("/solar/elevation")
def solar_elevation(
    latitude: float = Query(-89.67, ge=-90, le=90),
    longitude: float = Query(129.78, ge=-180, le=180),
    date_time: str = Query("2026-11-03T12:00:00"),
):
    if not kernels_loaded:
        raise HTTPException(
            status_code=503,
            detail=f"SPICE kernels are not ready: {kernel_error}",
        )

    utc_text, et, point, normal_unit = get_observation(
        latitude, longitude, date_time
    )

    try:
        sun_state, _ = spice.spkezr(
            "SUN", et, MOON_FRAME, "NONE", "MOON"
        )

        sun_direction = [
            sun_state[i] - point[i] for i in range(3)
        ]

        direction_unit = spice.vhat(sun_direction)

        dot_product = spice.vdot(normal_unit, direction_unit)
        dot_product = max(-1.0, min(1.0, dot_product))

        elevation = math.degrees(math.asin(dot_product))

        return {
            "project": "Lunar Chronos",
            "calculation": "Solar elevation",
            "date_time_utc": utc_text,
            "latitude_deg": latitude,
            "longitude_deg": longitude,
            "solar_elevation_deg": round(elevation, 4),
            "sun_above_reference_horizon": elevation > 0,
            "reference_frame": MOON_FRAME,
            "ephemeris": "JPL DE440",
            "surface_model": "Spherical Moon",
            "reference_radius_km": MOON_RADIUS_KM,
            "terrain_obstruction_included": False,
            "coordinate_convention_verified": False,
            "scientific_status": (
                "Geometric calculation; coordinate convention "
                "and terrain effects require further validation."
            ),
        }

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Solar calculation failed: {str(exc)}",
        )


@app.get("/earth/visibility")
def earth_visibility(
    latitude: float = Query(-89.67, ge=-90, le=90),
    longitude: float = Query(129.78, ge=-180, le=180),
    date_time: str = Query("2026-11-03T12:00:00"),
):
    if not kernels_loaded:
        raise HTTPException(
            status_code=503,
            detail=f"SPICE kernels are not ready: {kernel_error}",
        )

    utc_text, et, point, normal_unit = get_observation(
        latitude, longitude, date_time
    )

    try:
        earth_state, _ = spice.spkezr(
            "EARTH", et, MOON_FRAME, "NONE", "MOON"
        )

        earth_position = earth_state[:3]

        earth_direction = [
            earth_position[i] - point[i] for i in range(3)
        ]

        distance_km = spice.vnorm(earth_direction)
        direction_unit = spice.vhat(earth_direction)

        dot_product = spice.vdot(normal_unit, direction_unit)
        dot_product = max(-1.0, min(1.0, dot_product))

        centre_elevation = math.degrees(
            math.asin(dot_product)
        )

        angular_radius = math.degrees(
            math.asin(min(1.0, EARTH_RADIUS_KM / distance_km))
        )

        upper_limb_elevation = centre_elevation + angular_radius
        lower_limb_elevation = centre_elevation - angular_radius

        if upper_limb_elevation <= 0:
            visibility = "Earth disk below geometric horizon"
        elif lower_limb_elevation >= 0:
            visibility = "Entire Earth disk above geometric horizon"
        else:
            visibility = "Part of Earth disk above geometric horizon"

        return {
            "project": "Lunar Chronos",
            "calculation": "Earth geometric visibility",
            "date_time_utc": utc_text,
            "latitude_deg": latitude,
            "longitude_deg": longitude,
            "earth_centre_elevation_deg": round(
                centre_elevation, 4
            ),
            "earth_angular_radius_deg": round(
                angular_radius, 4
            ),
            "earth_upper_limb_elevation_deg": round(
                upper_limb_elevation, 4
            ),
            "earth_lower_limb_elevation_deg": round(
                lower_limb_elevation, 4
            ),
            "earth_distance_km": round(distance_km, 2),
            "visibility": visibility,
            "any_part_geometrically_visible": (
                upper_limb_elevation > 0
            ),
            "entire_disk_geometrically_visible": (
                lower_limb_elevation >= 0
            ),
            "reference_frame": MOON_FRAME,
            "ephemeris": "JPL DE440",
            "surface_model": "Spherical Moon",
            "earth_radius_model": (
                "Spherical Earth, equatorial radius 6378.1366 km"
            ),
            "terrain_obstruction_included": False,
            "atmospheric_refraction_included": False,
            "coordinate_convention_verified": False,
            "communications_availability_verified": False,
            "scientific_status": (
                "Geometric line-of-sight estimate only. "
                "Local terrain, antenna constraints and actual "
                "communications network availability are not included."
            ),
        }

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Earth visibility calculation failed: {str(exc)}",
        )


@app.get("/earth/windows")
def earth_visibility_windows(
    latitude: float = Query(-89.67, ge=-90, le=90),
    longitude: float = Query(129.78, ge=-180, le=180),
    date_time: str = Query("2026-11-03T00:00:00"),
    duration_hours: int = Query(708, ge=1, le=1000),
    step_minutes: int = Query(60, ge=1, le=1440),
):
    if not kernels_loaded:
        raise HTTPException(
            status_code=503,
            detail=f"SPICE kernels are not ready: {kernel_error}",
        )

    utc_text, start_et, point, normal_unit = get_observation(
        latitude, longitude, date_time
    )

    try:
        samples = []
        total_steps = math.ceil(
            duration_hours * 60 / step_minutes
        )

        for index in range(total_steps + 1):
            et = start_et + index * step_minutes * 60

            earth_state, _ = spice.spkezr(
                "EARTH", et, MOON_FRAME, "NONE", "MOON"
            )

            earth_direction = [
                earth_state[i] - point[i] for i in range(3)
            ]

            distance_km = spice.vnorm(earth_direction)
            direction_unit = spice.vhat(earth_direction)

            dot_product = spice.vdot(
                normal_unit, direction_unit
            )
            dot_product = max(-1.0, min(1.0, dot_product))

            centre_elevation = math.degrees(
                math.asin(dot_product)
            )

            angular_radius = math.degrees(
                math.asin(min(1.0, EARTH_RADIUS_KM / distance_km))
            )

            upper_limb = centre_elevation + angular_radius

            sample_time = spice.et2utc(
                et, "ISOC", 0
            )

            samples.append({
                "date_time_utc": sample_time,
                "earth_upper_limb_elevation_deg": round(
                    upper_limb, 4
                ),
                "any_part_geometrically_visible": upper_limb > 0,
            })

        windows = []
        window_start = None

        for sample in samples:
            visible = sample["any_part_geometrically_visible"]

            if visible and window_start is None:
                window_start = sample["date_time_utc"]

            elif not visible and window_start is not None:
                windows.append({
                    "start_utc": window_start,
                    "end_utc": samples[
                        samples.index(sample) - 1
                    ]["date_time_utc"],
                })
                window_start = None

        if window_start is not None:
            windows.append({
                "start_utc": window_start,
                "end_utc": samples[-1]["date_time_utc"],
            })

        return {
            "project": "Lunar Chronos",
            "calculation": "Sampled Earth visibility windows",
            "start_utc": utc_text,
            "latitude_deg": latitude,
            "longitude_deg": longitude,
            "duration_hours": duration_hours,
            "sampling_interval_minutes": step_minutes,
            "sample_count": len(samples),
            "visible_windows": windows,
            "samples": samples,
            "reference_frame": MOON_FRAME,
            "ephemeris": "JPL DE440",
            "surface_model": "Spherical Moon",
            "terrain_obstruction_included": False,
            "coordinate_convention_verified": False,
            "communications_availability_verified": False,
            "scientific_status": (
                "Sampled geometric visibility only. Window boundaries "
                "are limited by the sampling interval and are not "
                "precisely interpolated."
            ),
        }

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Earth window calculation failed: {str(exc)}",
        )


# ============================================================
# COSMIC CALENDAR — UST API
# ============================================================

@app.get("/ust/calendar")
def get_ust_calendar(
    date_time: str = Query(
        ...,
        description=(
            "ISO 8601 datetime with timezone. "
            "Example: 2026-11-06T12:00:00Z"
        ),
    )
):
    """
    Return the provisional UST calendar position.

    This endpoint does not perform UTC-to-TCL conversion.
    """

    try:
        return calculate_ust(date_time)

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc),
        )