    verification: 'NASA and Firefly confirm the launch, landing, ten NASA payloads and mission conclusion. LuGRE acquired and tracked GNSS signals at the Moon; this does not validate a separate lunar timekeeping system.',
    lastVerified: VERIFIED_DATE,
    sources: [
      sources.blueGhostNasa,
      sources.blueGhostFirefly,
      sources.blueGhostConclusion,
    ],
    payloads: blueGhost1Payloads,
  },
  {
    id: 'im-2',
    name: 'IM-2 (Athena)',
    provider: 'Intuitive Machines',
    taskOrder: 'TO Polar Resources Ice Mining Experiment-1 (PRIME-1)',
    lander: 'Nova-C — Athena',
    orbitalVehicle: 'None',
    launchVehicle: 'SpaceX Falcon 9',
    launchSite: 'Launch Complex 39A, Kennedy Space Center, Florida, USA',
    launchDate: '27 February 2025 UTC',
    launchDateStatus: 'Actual launch date; 26 February in US Eastern local reporting',
    landingDate: '6 March 2025, approximately 17:30 UTC',
    destination: 'Mons Mouton region, lunar south polar region',
    destinationStatus: 'Actual touchdown approximately 250 metres from intended landing site',
    outcome: 'Athena achieved lunar touchdown inside a crater but came to rest on its side. Payload operations were curtailed by the lander attitude, illumination conditions and battery depletion. Intuitive Machines declared the mission concluded on 7 March 2025.',
    status: 'Mission concluded',
    payloadSummary: 'Three NASA instruments, plus technology demonstrations and commercial payloads',
    payloadBreakdown: 'NASA PDS identifies three NASA instruments: TRIDENT, MSOLO and LRA. TRIDENT and MSOLO form the PRIME-1 instrument suite; LRA is listed separately. The Micro Nova hopper and Nokia communications system are recorded separately as technology demonstrations.',
    chronology: [
      '27 February 2025 UTC — Launch aboard SpaceX Falcon 9.',
      '6 March 2025 — Lunar touchdown near Mons Mouton.',
      '6 March 2025 — Lander confirmed to be on its side; limited payload operations.',
      '7 March 2025 — Mission concluded at 00:15 CST.',
    ],
    verification: 'NASA identifies the task order as TO Polar Resources Ice Mining Experiment-1 (PRIME-1). NASA and Intuitive Machines report approximately 250 metres between touchdown and the intended landing site. NASA PDS confirms the lander orientation prevented TRIDENT from reaching the surface. The mission achieved touchdown but did not complete all planned surface objectives.',
    lastVerified: VERIFIED_DATE,
    sources: [
      sources.im2Nasa,
      sources.im2Pds,
      sources.im2Prime,
      sources.im2Provider,
    ],
    payloads: im2Payloads,
  },
  {
    id: 'blue-ghost-2',
    name: 'Blue Ghost Mission 2',
    missionName: 'Riders 2 the Dark',
    provider: 'Firefly Aerospace',
    taskOrder: 'Firefly confirms two CLPS task orders; NASA identifies CS-3. The second identifier is not independently confirmed in the cited sources.',
    lander: 'Blue Ghost',
    orbitalVehicle: 'Elytra Dark',
    launchVehicle: 'SpaceX Falcon 9 — planned, according to ESA (2027)',
    launchSite: 'Not confirmed in the current Firefly mission source',
    launchDate: 'No earlier than 2027',
    launchDateStatus: 'Firefly mission-page target; not a confirmed launch date',
    landingDate: 'Not yet available',
    destination: 'Nassau Crater region, lunar far side',
    destinationStatus: 'Planned landing region',
    outcome: 'Future mission. Blue Ghost is planned to land on the lunar far side. Elytra Dark is a separate transfer and orbital vehicle planned to deploy Lunar Pathfinder and provide orbital relay and radio-frequency calibration services. Lunar Pathfinder is a separate ESA communications satellite planned for an elliptical lunar frozen orbit.',
    status: 'In development',
    payloadSummary: 'Six mission-level elements: five Blue Ghost surface payloads and Lunar Pathfinder, a separate orbital satellite',
    payloadBreakdown: 'Six mission-level elements are identified: five Blue Ghost surface payloads and Lunar Pathfinder, a separate orbital satellite. Four additional hosted equipment records are listed in the subordinate Lunar Pathfinder register. They are not additional mission-level elements or Blue Ghost surface payloads.',
    chronology: [
      'Mission development — Dual-spacecraft Blue Ghost and Elytra Dark architecture.',
      'Launch — No earlier than 2027, according to Firefly’s mission page.',
      'Lunar orbit — Elytra Dark is planned to deploy Blue Ghost and Lunar Pathfinder.',
      'Orbital deployment — Lunar Pathfinder is planned to enter an elliptical lunar frozen orbit.',
      'Orbital operations — Firefly describes five years of planned Elytra Dark operations; ESA describes an approximately eight-year planned service lifetime for Lunar Pathfinder. These are separate spacecraft and separate service-life estimates.',
      'Lunar surface — Blue Ghost is planned to support payload operations.',
    ],
    verification: 'Firefly identifies six mission-level elements: five Blue Ghost surface payloads and Lunar Pathfinder, a separate orbital satellite. ESA identifies four hosted orbital equipment items aboard Lunar Pathfinder: RADMON, a GNSS receiver, a NASA laser retroreflector and an X-band transponder. These are subordinate equipment records, not additional Blue Ghost surface payloads. Firefly gives a no-earlier-than-2027 launch target. All future operations remain plans, not achieved results.',
    lastVerified: VERIFIED_DATE,
    sources: [
      sources.blueGhost2Firefly,
      sources.lunarPathfinderEsa,
      sources.lunarPathfinderEsaEquipment,
      sources.nasaMoonBase,
    ],
    payloads: blueGhost2Payloads,
    hostedEquipment: blueGhost2HostedEquipment,
  },
  {
    id: 'im-3',
    name: 'IM-3',
    provider: 'Intuitive Machines',
    taskOrder: 'CP-11 (CLPS PRISM 11)',
    lander: 'Nova-C — Trinity',
    orbitalVehicle: 'Altus-1 lunar data-relay satellite',
    launchVehicle: 'Not confirmed in the current cited mission sources',
    launchSite: 'Not confirmed in the current cited mission sources',
    launchDate: 'Early 2027',
    launchDateStatus: 'NASA launch schedule target; not a confirmed launch date',
    landingDate: 'Not yet available',
    destination: 'Reiner Gamma, lunar near side',
    destinationStatus: 'Planned landing region',
    outcome: 'Future mission. Trinity is planned to deliver surface investigations to Reiner Gamma. Altus-1 is a separate orbital spacecraft intended to support lunar communications and data-relay services.',
    status: 'In development',
    payloadSummary: '12 planned surface payloads: five NASA, six commercial and one civil; three additional payloads aboard Altus-1',
    payloadBreakdown: 'NASA reports aggregate payload totals for the surface mission and Altus-1. This registry lists only payloads individually identified in the current NASA material: Lunar Vertex and LDES for the surface mission, and NavCube3-mini for Altus-1. Altus-1 itself is a spacecraft, not a payload. The remaining payload names are not invented or represented as individually verified records.',
    chronology: [
      'Mission preparation — Trinity lander and Altus-1 orbital architecture.',
      'Launch — Early 2027 in NASA’s current launch schedule; no confirmed launch date.',
      'Lunar landing — Planned at Reiner Gamma; date not yet available.',
      'Orbital operations — Altus-1 is planned to support lunar communications and data-relay services.',
    ],
    verification: 'NASA identifies CP-11, Trinity, Reiner Gamma, Lunar Vertex, LDES and Altus-1. NASA reports five NASA, six commercial and one civil surface payload, plus three payloads aboard Altus-1. NavCube3-mini is individually identified as an Altus-1 payload. The complete payload manifest is not reproduced because the current cited NASA material does not individually identify every payload. NASA’s current launch schedule lists the mission for early 2027; no precise launch date is asserted.',
    lastVerified: VERIFIED_DATE,
    sources: [
      sources.nasaMoonBase,
      sources.nasaLaunchSchedule,
      sources.im3Provider,
      sources.im3NavCube,
    ],
    payloads: im3Payloads,
  },
];

const statusOptions = [
  'All',
  'Mission concluded',
  'In development',
];

function NumberedHeading({
  number,
  children,
}: {
  number: string;
  children: ReactNode;
}) {
  return (
    <h4 className="clps-numbered-heading">
      <span className="clps-heading-number">{number}</span>
      <span className="clps-heading-title">{children}</span>
    </h4>
  );
}

function CLPSBrowser() {
  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState('All');
  const [expandedMission, setExpandedMission] = useState<string | null>(null);

  const filteredMissions = useMemo(() => {
    const query = search.toLowerCase().trim();

    return missions.filter((mission) => {
      const payloadSearchText = [
        ...mission.payloads,
        ...(mission.hostedEquipment ? []),
      ]
        .map((payload) =>
          [
            payload.acronym,
            payload.name,
            payload.organisation,
            payload.category,
            payload.objective,
          ].join(' '),
        )
        .join(' ');

      const searchableText = [
        mission.name,
        mission.missionName ? '',
        mission.provider,
        mission.taskOrder,
        mission.lander,
        mission.orbitalVehicle,
        mission.destination,
        mission.payloadSummary,
        mission.payloadBreakdown,
        mission.launchVehicle,
        mission.launchSite,
        mission.outcome,
        payloadSearchText,
      ]
        .join(' ')
        .toLowerCase();

      const matchesSearch = searchableText.includes(query);
      const matchesStatus =
        statusFilter === 'All' || mission.status === statusFilter;

      return matchesSearch && matchesStatus;
    });
  }, [search, statusFilter]);

  const statusClass = (status: MissionStatus) =>
    `clps-status status-${status.toLowerCase().replaceAll(' ', '-')}`;

  const toggleDetails = (missionId: string) => {
    setExpandedMission((current) =>
      current === missionId ? null : missionId,
    );
  };

  return (
    <section className="clps-section">
      <div className="section-heading">
        <div>
          <p className="eyebrow">
            LUNAR CHRONOS / COMMERCIAL LUNAR PAYLOAD SERVICES
          </p>
          <h2>CLPS Mission Registry</h2>
          <p className="section-description">
            Independently maintained mission records, spacecraft,
            launch and landing events, destinations, payloads and
            operational outcomes.
          </p>
        </div>
      </div>

      <div className="clps-controls">
        <input
          type="search"
          placeholder="Search missions, providers, destinations or payloads..."
          value={search}
          onChange={(event) => setSearch(event.target.value)}
          aria-label="Search CLPS missions"
        />

        <select
          value={statusFilter}
          onChange={(event) => setStatusFilter(event.target.value)}
          aria-label="Filter missions by status"
        >
          {statusOptions.map((status) => (
            <option key={status} value={status}>
              {status === 'All' ? 'All statuses' : status}
            </option>
          ))}
        </select>
      </div>

      <div className="clps-table-heading">
        <span className="eyebrow">MISSION RECORDS</span>
        <span className="clps-count">
          {filteredMissions.length} / {missions.length} records
        </span>
      </div>

      <div className="clps-table-wrap">
        <table className="clps-table">
          <thead>
            <tr>
              <th>Mission</th>
              <th>Provider</th>
              <th>Lander</th>
              <th>Destination</th>
              <th>Launch target / date</th>
              <th>Status</th>
              <th>Details</th>
            </tr>
          </thead>

          <tbody>
            {filteredMissions.map((mission) => {
              const isExpanded = expandedMission === mission.id;
              const detailsId = `mission-details-${mission.id}`;

              return (
                <Fragment key={mission.id}>
                  <tr>
                    <td><strong>{mission.name}</strong></td>
                    <td>{mission.provider}</td>
                    <td>{mission.lander}</td>
                    <td>{mission.destination}</td>
                    <td>{mission.launchDate}</td>
                    <td>
                      <span className={statusClass(mission.status)}>
                        {mission.status}
                      </span>
                    </td>
                    <td>
                      <button
                        type="button"
                        className="clps-details-button"
                        onClick={() => toggleDetails(mission.id)}
                        aria-expanded={isExpanded}
                        aria-controls={detailsId}
                      >
                        {isExpanded ? 'CLOSE âˆ’' : 'VIEW +'}
                      </button>
                    </td>
                  </tr>

                  {isExpanded && (
                    <tr className="clps-expanded-row">
                      <td colSpan={7}>
                        <div
                          className="clps-expanded-content"
                          id={detailsId}
                        >
                          <div className="clps-expanded-heading">
                            <div>
                              <span className="eyebrow">MISSION RECORD</span>
                              <h3>{mission.name}</h3>
                              {mission.missionName && (
                                <p className="section-description">
                                  Mission name: {mission.missionName}
                                </p>
                              )}
                            </div>
                            <span className={statusClass(mission.status)}>
                              {mission.status}
                            </span>
                          </div>

                          <NumberedHeading number="01">
                            Mission identification
                          </NumberedHeading>

                          <div className="clps-detail-grid">
                            <div>
                              <span>PROVIDER</span>
                              <strong>{mission.provider}</strong>
                            </div>
                            {mission.missionName && (
                              <div>
                                <span>MISSION NAME</span>
                                <strong>{mission.missionName}</strong>
                              </div>
                            )}
                            <div>
                              <span>CLPS TASK ORDER</span>
                              <strong>{mission.taskOrder}</strong>
                            </div>
                            <div>
                              <span>LANDER</span>
                              <strong>{mission.lander}</strong>
                            </div>
                            <div>
                              <span>ORBITAL VEHICLE</span>
                              <strong>{mission.orbitalVehicle}</strong>
                            </div>
                            <div>
                              <span>DESTINATION</span>
                              <strong>{mission.destination}</strong>
                            </div>
                            <div>
                              <span>DESTINATION STATUS</span>
                              <strong>{mission.destinationStatus}</strong>
                            </div>
                            <div>
                              <span>LAUNCH VEHICLE</span>
                              <strong>{mission.launchVehicle}</strong>
                            </div>
                            <div>
                              <span>LAUNCH SITE</span>
                              <strong>{mission.launchSite}</strong>
                            </div>
                          </div>

                          <NumberedHeading number="02">
                            Mission chronology
                          </NumberedHeading>

                          <div className="clps-detail-grid">
                            <div>
                              <span>LAUNCH DATE / TARGET</span>
                              <strong>{mission.launchDate}</strong>
                            </div>
                            <div>
                              <span>DATE CLASSIFICATION</span>
                              <strong>{mission.launchDateStatus}</strong>
                            </div>
                            <div>
                              <span>LUNAR LANDING DATE</span>
                              <strong>{mission.landingDate}</strong>
                            </div>
                            <div className="clps-payload-detail">
                              <span>MISSION OUTCOME</span>
                              <strong>{mission.outcome}</strong>
                            </div>
                          </div>

                          <ul className="clps-chronology">
                            {mission.chronology.map((event, index) => (
                              <li key={`${mission.id}-event-${index}`}>
                                {event}
                              </li>
                            ))}
                          </ul>

                          <NumberedHeading number="03">
                            Payload information
                          </NumberedHeading>

                          <div className="clps-detail-grid">
                            <div>
                              <span>PAYLOAD SUMMARY</span>
                              <strong>{mission.payloadSummary}</strong>
                            </div>
                            <div className="clps-payload-detail">
                              <span>PAYLOAD OVERVIEW</span>
                              <strong>{mission.payloadBreakdown}</strong>
                            </div>
                          </div>

                          <div className="clps-payload-heading">
                            <div>
                              <span className="eyebrow">
                                INSTRUMENT AND SPACECRAFT REGISTER
                              </span>
                              <h4>
                                Individually identified payload records ({mission.payloads.length})
                              </h4>
                            </div>
                            <span className="clps-count">
                              {mission.payloads.length} named records
                            </span>
                          </div>

                          <div className="clps-payload-list">
                            {mission.payloads.map((payload, index) => (
                              <article
                                className="clps-payload-card"
                                key={payload.acronym}
                              >
                                <div className="clps-payload-card-heading">
                                  <span className="clps-payload-number">
                                    {String(index + 1).padStart(2, '0')}
                                  </span>

                                  <div className="clps-payload-title">
                                    <strong>{payload.acronym}</strong>
                                    <h5>{payload.name}</h5>
                                  </div>
                                </div>

                                <div className="clps-payload-fields">
                                  <div>
                                    <span>CATEGORY</span>
                                    <p>{payload.category}</p>
                                  </div>
                                  <div>
                                    <span>RESPONSIBLE ORGANISATION</span>
                                    <p>{payload.organisation}</p>
                                  </div>
                                  <div>
                                    <span>MISSION OBJECTIVE</span>
                                    <p>{payload.objective}</p>
                                  </div>
                                  <div>
                                    <span>OPERATIONAL RECORD</span>
                                    <p>{payload.operationalRecord}</p>
                                  </div>
                                  <div>
                                    <span>EVIDENCE STATUS</span>
                                    <p>{payload.evidenceStatus}</p>
                                  </div>
                                </div>

                                <div className="clps-payload-sources">
                                  {payload.sources.map((source) => (
                                    <a
                                      key={`${payload.acronym}-${source.publisher}-${source.title}`}
                                      href={source.url}
                                      target="_blank"
                                      rel="noreferrer"
                                    >
                                      {source.publisher} — {source.title} â†—
                                    </a>
                                  ))}
                                </div>
                              </article>
                            ))}
                          </div>

                          {mission.hostedEquipment &&
                            mission.hostedEquipment.length > 0 && (
                              <>
                                <div className="clps-payload-heading">
                                  <div>
                                    <span className="eyebrow">
                                      SEPARATE ORBITAL EQUIPMENT REGISTER
                                    </span>
                                    <h4>
                                      Lunar Pathfinder — Orbital Spacecraft and Hosted Instruments ({mission.hostedEquipment.length})
                                    </h4>
                                  </div>
                                  <span className="clps-count">
                                    {mission.hostedEquipment.length} hosted records
                                  </span>
                                </div>

                                <p className="section-description">
                                  These records concern equipment hosted aboard
                                  the separate Lunar Pathfinder orbital
                                  satellite. They are not additional Blue Ghost
                                  surface payloads and are not included in the
                                  six mission-level elements.
                                </p>

                                <div className="clps-payload-list">
                                  {mission.hostedEquipment.map((equipment, index) => (
                                    <article
                                      className="clps-payload-card"
                                      key={equipment.acronym}
                                    >
                                      <div className="clps-payload-card-heading">
                                        <span className="clps-payload-number">
                                          {String(index + 1).padStart(2, '0')}
                                        </span>

                                        <div className="clps-payload-title">
                                          <strong>{equipment.acronym}</strong>
                                          <h5>{equipment.name}</h5>
                                        </div>
                                      </div>

                                      <div className="clps-payload-fields">
                                        <div>
                                          <span>CATEGORY</span>
                                          <p>{equipment.category}</p>
                                        </div>
                                        <div>
                                          <span>RESPONSIBLE ORGANISATION</span>
                                          <p>{equipment.organisation}</p>
                                        </div>
                                        <div>
                                          <span>MISSION OBJECTIVE</span>
                                          <p>{equipment.objective}</p>
                                        </div>
                                        <div>
                                          <span>OPERATIONAL RECORD</span>
                                          <p>{equipment.operationalRecord}</p>
                                        </div>
                                        <div>
                                          <span>EVIDENCE STATUS</span>
                                          <p>{equipment.evidenceStatus}</p>
                                        </div>
                                      </div>

                                      <div className="clps-payload-sources">
                                        {equipment.sources.map((source) => (
                                          <a
                                            key={`${equipment.acronym}-${source.publisher}-${source.title}`}
                                            href={source.url}
                                            target="_blank"
                                            rel="noreferrer"
                                          >
                                            {source.publisher} — {source.title} â†—
                                          </a>
                                        ))}
                                      </div>
                                    </article>
                                  ))}
                                </div>
                              </>
                            )}

                          <div className="clps-verification-note">
                            <strong>RECORD VERIFICATION</strong>
                            <p>{mission.verification}</p>
                            <p>
                              Last verified: {mission.lastVerified}.
                              This date records the date of this registry
                              review; it does not imply that every payload
                              has a completed scientific performance audit.
                            </p>
                            <p>
                              This is an independently maintained Lunar
                              Chronos research dataset. It is not a live NASA
                              feed or a NASA-operated database.
                            </p>
                          </div>

                          <NumberedHeading number="04">
                            Source documents
                          </NumberedHeading>

                          <div className="clps-source-list">
                            {mission.sources.map((source) => (
                              <a
                                key={`${mission.id}-${source.publisher}-${source.title}`}
                                href={source.url}
                                target="_blank"
                                rel="noreferrer"
                              >
                                {source.publisher} — {source.title} â†—
                              </a>
                            ))}
                          </div>
                        </div>
                      </td>
                    </tr>
                  )}
                </Fragment>
              );
            })}
          </tbody>
        </table>

        {filteredMissions.length === 0 && (
          <p className="data-note clps-empty">
            No mission records match your search.
          </p>
        )}
      </div>

      <div className="clps-data-integrity">
  <div className="clps-data-integrity-header">
    <div><span>CLPS · DATA GOVERNANCE</span><h3>Mission data integrity</h3></div>
    <strong>INDEPENDENT DATASET</strong>
  </div>
  <div className="clps-data-metrics">
    <div><strong>06</strong><span>MISSION RECORDS</span></div>
    <div><strong>04</strong><span>CONCLUDED</span></div>
    <div><strong>02</strong><span>IN DEVELOPMENT</span></div>
  </div>
  <div className="clps-data-classification">
    <div><span>HISTORICAL OUTCOMES</span><strong>Recorded</strong></div>
    <div><span>FUTURE LAUNCH TARGETS</span><strong>Subject to change</strong></div>
  </div>
  <div className="clps-data-provenance">
    <span>SOURCE TRACEABILITY</span>
    <p>Each mission record provides available NASA and provider references, verification dates and documented payload evidence.</p>
  </div>
  <small>INDEPENDENT RESEARCH DATASET · NOT AN OFFICIAL NASA REGISTRY</small>
</div>
    </section>
  );
}

export default CLPSBrowser;
