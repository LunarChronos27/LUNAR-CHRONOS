function makePayload(
  acronym: string,
  name: string,
  organisation: string,
  category: string,
  objective: string,
  operationalRecord: string,
  evidenceStatus: string,
  payloadSources: SourceRecord[],
): PayloadRecord {
  return {
    acronym,
    name,
    organisation,
    category,
    objective,
    operationalRecord,
    evidenceStatus,
    sources: payloadSources,
  };
}

