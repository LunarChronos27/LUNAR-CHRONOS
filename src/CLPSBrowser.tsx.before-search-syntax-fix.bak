import { Fragment, useMemo, useState, type ReactNode } from 'react';

type MissionStatus = 'Mission concluded' | 'In development';

type SourceRecord = {
  publisher: string;
  title: string;
  url: string;
};

type PayloadRecord = {
  acronym: string;
  name: string;
  organisation: string;
  category: string;
  objective: string;
  operationalRecord: string;
  evidenceStatus: string;
  sources: SourceRecord[];
};

type Mission = {
  id: string;
  name: string;
  missionName?: string;
  provider: string;
  taskOrder: string;
  lander: string;
  orbitalVehicle: string;
  launchVehicle: string;
  launchSite: string;
  launchDate: string;
  launchDateStatus: string;
  landingDate: string;
  destination: string;
  destinationStatus: string;
  outcome: string;
  status: MissionStatus;
  payloadSummary: string;
  payloadBreakdown: string;
  chronology: string[];
  verification: string;
  lastVerified: string;
  sources: SourceRecord[];
  payloads: PayloadRecord[];
  hostedEquipment?: PayloadRecord[];
};

